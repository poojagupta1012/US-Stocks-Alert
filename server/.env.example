# --- Required ---
# Free API key from https://finnhub.io/dashboard
FINNHUB_API_KEY=
# e.g. mongodb://localhost:27017/us-stocks-alert or a MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/us-stocks-alert
# Create a bot with @BotFather on Telegram and paste its token here
TELEGRAM_BOT_TOKEN=
# Gmail address that sends the alert emails
GMAIL_USER=
# 16-character App Password (Google Account > Security > 2-Step Verification > App passwords)
GMAIL_APP_PASSWORD=

# --- Optional ---
PORT=4000
# Origin of the Next.js client, used for CORS (comma-separated for several)
CLIENT_ORIGIN=http://localhost:3000
# When true, the bot replies to /start with the user's chat ID. Only one server
# instance may poll a given bot token at a time, so set false if you run several.
TELEGRAM_POLLING=true
